# Copy to /opt/workshop/.env (lab host) or ./.env (self-hosted) and fill in real values. Git-ignored.
# The provisioning scripts (instructor/runbook/scripts/*.sh) and docker-compose read these.
# SETUP.md explains where each credential comes from.

# Public DNS name of the lab host (instructor-led only). Used for the share site URL, the TLS cert,
# and the pre-flight checks. Self-hosted readers can leave it unset.
LAB_HOST="lab.example.com"

# Anthropic API key. makeuser.sh writes this into each seat's ~/.workshop_env (0600), students
# use it directly. Keep it short-lived and spend-limited, and revoke it when the class ends.
# See instructor/runbook/api-key-architecture.md for why we don't proxy it.
ANTHROPIC_API_KEY="sk-ant-REPLACE-ME"

# Seats: workshop<ID> for ID in [START_ID, START_ID+SEATS). IDs must stay within 10-49 because
# they prefix each seat's docker ports (see the port map in AGENDA.md).
SEATS="2"
START_ID="10"

# Per-attendee seat id: set per user by makeuser.sh in ~/.workshop_env; only set here when
# self-hosting a single seat.
WORKSHOPUID="12"

# Gravwell ingest secret for each seat's stack. Applied to the indexer (GRAVWELL_INGEST_AUTH),
# the bundled simple_relay (GRAVWELL_INGEST_SECRET) and the llm-ingester sidecar, all three must match.
GRAVWELL_INGEST_SECRET="IngestSecrets"

# Shared TLS cert dir on the lab host (root-owned; docker mounts it into every seat's Gravwell).
# Leave unset when self-hosting to fall back to labs/00-environment-gravwell/config/.
WORKSHOP_CERT_DIR="/opt/workshop/certs"

# Shared workshop user password. Empty => each seat gets "<username>password".
WORKSHOP_USER_PASSWORD=""

# Lab 01b (demystifying AI) talks to an Ollama-shaped model endpoint. Instructor-led: through a
# ROOT-ONLY loopback relay (instructor/runbook/scripts/start-llm-relay.sh) whose upstream URL + token
# live in instructor/runbook/gravwell-llm.env (git-ignored; copy the .example). Set these only to
# override that file. Seats never receive the token, only GRAVWELL_LLM_URL=http://<relay>.
# Self-hosted: skip the relay and point the scripts at Ollama directly (SETUP.md).
#LLM_UPSTREAM_URL="https://example.gravwell.space"
#LLM_UPSTREAM_TOKEN="REPLACE-ME"
#LLM_RELAY_LISTEN="127.0.0.1:9010"

# Gravwell MCP token for opencode in the MCP modules. Unused by the current labs (each seat mints its
# own API token in Lab 00); leave empty unless a lab of yours needs a shared one.
GRAVWELL_MCP_TOKEN=""

# Share server (nginx in docker, HTTPS + basic auth): the URL you read out to the room.
# Basic auth keeps crawlers and bots off the material; it is not a secrecy measure. Pick something
# a student can type from hearing it once.
SHARE_USER="workshop"
SHARE_PASSWORD="REPLACE-ME"

# Let's Encrypt account email for issue-cert.sh
EMAIL="you@example.com"
